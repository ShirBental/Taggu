# ---------------------------------------------------------------------------
# Real conversation exports must never be committed.
#
# Everything that looks like a chat export is ignored, and the synthetic
# conversations under sample-data/ are the single explicit exception.
# ---------------------------------------------------------------------------
*.txt
!sample-data/*.txt
!**/src/test/resources/**/*.txt
/exports/
/imports/
/private/
