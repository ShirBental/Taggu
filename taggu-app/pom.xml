<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.taggu</groupId>
    <artifactId>taggu</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>
  <artifactId>taggu-app</artifactId>
  <name>taggu-app</name>
  <description>Spring Boot application: import orchestration, query services and the REST API</description>
  <dependencies>
    <dependency>
      <groupId>com.taggu</groupId>
      <artifactId>taggu-core</artifactId>
    </dependency>
    <dependency>
      <groupId>com.taggu</groupId>
      <artifactId>taggu-ingest-whatsapp</artifactId>
    </dependency>
    <dependency>
      <groupId>com.taggu</groupId>
      <artifactId>taggu-extraction</artifactId>
    </dependency>
    <dependency>
      <groupId>com.taggu</groupId>
      <artifactId>taggu-persistence</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <skip>false</skip>
          <mainClass>com.taggu.app.TagguApplication</mainClass>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
